{
  "name": "addendum-echo",
  "version": "1.0.0",
  "private": true,
  "description": "A local, deterministic addendum acknowledgment evidence check.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-playwright.mjs",
    "audit:project": "node scripts/audit.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run audit:project && npm audit --audit-level=high && npm run test:e2e"
  },
  "dependencies": {
    "pdfjs-dist": "5.3.31"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.0",
    "@types/node": "24.1.0",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
